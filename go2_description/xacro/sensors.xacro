<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro" />

  <xacro:mid360 name="livox_mid360" parent="trunk" topic="livox_mid360">
    <origin xyz="0 0 0.1" rpy="0 0 0" />
  </xacro:mid360>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="trunk"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.18 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="depth_camera_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.02 0.02"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.02 0.02"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="depth_camera_link">
    <sensor type="depth" name="depth_camera">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.52</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>B8G8R8</format>
        </image>
        <depth_camera/>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>depth_camera</camera_name>
        <min_depth>0.05</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>
